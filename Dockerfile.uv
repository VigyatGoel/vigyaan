#### Multistage Dockerfile using Astral uv ####

# 1) Builder stage: resolve and install dependencies with uv into a project venv
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

# Build tools needed only at build time (manylinux wheels will often avoid compiling)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy resolver inputs first for caching
COPY pyproject.toml uv.lock /app/

# Install dependencies into /app/.venv according to the lockfile
RUN uv sync --frozen --no-cache


# 2) Runtime stage: slim Python image with only runtime deps and the app code
FROM python:3.13-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    BACKEND_PORT=8000 \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

# Runtime system deps: curl for healthcheck, libgomp for OpenMP (scikit-learn, numpy)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Bring in the prebuilt virtualenv from the builder image
COPY --from=builder /app/.venv /app/.venv

# Ensure venv is first on PATH
ENV PATH="/app/.venv/bin:${PATH}"

# Copy application source
COPY src /app/src
COPY streamlit_frontend /app/streamlit_frontend
COPY run_all.sh /app/run_all.sh

RUN chmod +x /app/run_all.sh && mkdir -p /app/uploads /app/src/csvfiles

# Expose default dev port; Cloud Run will override via $PORT automatically.
EXPOSE 8501

# Healthcheck via Streamlit (backend kept private). Adjust path if you add a custom health route.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["/app/run_all.sh"]
